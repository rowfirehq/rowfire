# Copy to deploy/hosted/.env on the server and fill in. Never commit .env.

# The public name, e.g. demo.rowfire.dev. DNS must point at this server.
DOMAIN=

# Wraps every credential RowFire stores. Generate once and keep it:
#   openssl rand -base64 32 | tr '+/' '-_'
ROWFIRE_MASTER_KEY=

# Where "Give feedback" in the demo's banner goes.
ROWFIRE_FEEDBACK_URL=https://github.com/rowfirehq/rowfire/discussions

# Optional. Markup added to the end of the page's <head>, such as an
# analytics tag. Leave it unset and the page is served exactly as built.
# ROWFIRE_HEAD_HTML='<script defer src="https://analytics.example/tag.js"></script>'

# Optional. Defaults shown.
# ROWFIRE_WORKSPACE_IDLE_HOURS=24
# ROWFIRE_MAX_WORKSPACES=200
# CONTROLPLANE_PASSWORD=rowfire
# SAMPLE_PASSWORD=rowfire
# SUPPORT_PASSWORD=rowfire
