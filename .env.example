# Copy to .env and fill in a master key. .env is gitignored; this file is not.
#
# The master key wraps every stored credential. Losing it makes the stored
# database connection and every connector secret unrecoverable, so keep the
# real one somewhere durable rather than only in this directory.
#
# Generate one:
#
#   openssl rand -base64 32 | tr '+/' '-_'
#
# or, with the project installed:
#
#   uv run rowfire platform init-key
#
ROWFIRE_MASTER_KEY=

# Host port for the UI. 8000 is often taken.
ROWFIRE_UI_PORT=8000

# Host ports for the fixture databases and the control plane. 5432 and 3306
# are often taken by a local install.
# ROWFIRE_PG_PORT=5433
# ROWFIRE_CP_PORT=5434
# ROWFIRE_MYSQL_PORT=3307

# Optional: Supabase. A demo project to offer as a one-click source (set it up
# with examples/saas/supabase.sql), a token to read supabase:// sources with,
# and an OAuth app for "Connect Supabase" (see the README's Supabase section).
# ROWFIRE_DEMO_SUPABASE_DSN=supabase://<project ref>
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_OAUTH_CLIENT_ID=
# SUPABASE_OAUTH_CLIENT_SECRET=
# ROWFIRE_PUBLIC_URL=http://localhost:8000
